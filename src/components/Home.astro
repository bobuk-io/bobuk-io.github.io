---
import ShotCarousel from './ShotCarousel.astro';
import { apps } from '../data/apps';
import { ui, localPath } from '../i18n';
import type { Locale } from '../i18n';
const { locale } = Astro.props as { locale: Locale };
const t = ui[locale];
---
<section class="intro wrap">
  <p class="eyebrow"><span class="small-line"></span>{t.eyebrow}</p>
  <h1>{t.hero}<br /><span class="soft">{t.heroSoft}</span></h1>
  <div class="intro-bottom"><p>{t.intro}</p><a class="text-link" href="#apps">{t.findApp}<span aria-hidden="true">↓</span></a></div>
</section>
<section id="apps" class="catalog wrap" aria-labelledby="apps-title">
  <div class="section-heading"><h2 id="apps-title">{t.apps}</h2><span class="muted">{String(apps.length).padStart(2, '0')} / {t.catalog}</span></div>
  {apps.length ? apps.map((app, i) => {
    const copy = app.translations[locale];
    const page = localPath(locale, `apps/${app.slug}`);
    return <article class:list={['featured', { flip: i % 2 === 1 }]} aria-labelledby={`app-${app.slug}`}>
      <div class="featured-copy">
        <div class="app-identity"><img src={app.icon} width="64" height="64" alt="" loading={i ? 'lazy' : undefined} /><div><h3 id={`app-${app.slug}`}>{app.name}</h3><span>{app.platform} / {copy.category}</span></div></div>
        <p class="tagline">{copy.tagline}</p><p>{copy.description}</p>
        <div class="actions"><a class="button" href={page}>{t.explore}<span aria-hidden="true">↗</span></a><a class="text-link" href={`${page}#install`}>{t.install}<span aria-hidden="true">↓</span></a></div>
        <p class="requirements">{t.requirements}</p>
        {app.companions.length > 0 && <div class="integrations"><span>{t.companions}</span>{app.companions.map(name => <strong>{name}</strong>)}</div>}
      </div>
      <ShotCarousel app={app} locale={locale} priority={i === 0} />
    </article>;
  }) : <p class="empty">{t.empty}</p>}
</section>
<section class="principles wrap" aria-label={t.eyebrow}>{t.principles.map(p => <div><span class="index">{p.label}</span><h3>{p.title}</h3><p>{p.text}</p></div>)}</section>
<section class="closing wrap"><div><h2>{t.closing}</h2><p>{t.closingText}</p></div><a class="text-link" href={localPath(locale, 'support')}>{t.contact}<span aria-hidden="true">↗</span></a></section>
