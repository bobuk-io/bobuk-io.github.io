---
import ProductShot from './ProductShot.astro';
import { apps } from '../data/apps';
import { ui, localPath } from '../i18n';
import type { Locale } from '../i18n';
const { locale } = Astro.props as { locale: Locale };
const t = ui[locale];
const featured = apps[0];
const copy = featured?.translations[locale];
---
<section class="intro wrap">
  <p class="eyebrow"><span class="small-line"></span>{t.eyebrow}</p>
  <h1>{t.hero}<br /><span class="soft">{t.heroSoft}</span></h1>
  <div class="intro-bottom"><p>{t.intro}</p><a class="text-link" href="#apps">{t.findApp}<span aria-hidden="true">↓</span></a></div>
</section>
<section id="apps" class="catalog wrap" aria-labelledby="apps-title">
  <div class="section-heading"><h2 id="apps-title">{t.apps}</h2><span class="muted">{String(apps.length).padStart(2, '0')} / {t.catalog}</span></div>
  {featured && copy ? <article class="featured">
    <div class="featured-copy">
      <div class="app-identity"><img src={featured.icon} width="64" height="64" alt="" /><div><h3>{featured.name}</h3><span>{featured.platform} / {copy.category}</span></div></div>
      <h2>{copy.tagline}</h2><p>{copy.description}</p>
      <div class="actions"><a class="button" href={localPath(locale, `apps/${featured.slug}`)}>{t.explore}<span aria-hidden="true">↗</span></a><a class="text-link" href={`${localPath(locale, `apps/${featured.slug}`)}#install`}>{t.install}<span aria-hidden="true">↓</span></a></div>
      <p class="requirements">{t.requirements}</p>
      <div class="integrations"><span>{t.companions}</span>{featured.companions.map(name => <strong>{name}</strong>)}</div>
    </div>
    <ProductShot app={featured} locale={locale} />
  </article> : <p class="empty">{t.empty}</p>}
  {apps.slice(1).map(app => <article class="app-row"><img class="row-icon" src={app.icon} width="80" height="80" alt="" loading="lazy" /><div><p class="index">{app.platform} / {app.translations[locale].category}</p><h3>{app.name}</h3><p>{app.translations[locale].description}</p></div><a class="button secondary" href={localPath(locale, `apps/${app.slug}`)}>{t.explore} ↗</a></article>)}
</section>
<section class="principles wrap" aria-label={t.eyebrow}>{t.principles.map(p => <div><span class="index">{p.label}</span><h3>{p.title}</h3><p>{p.text}</p></div>)}</section>
<section class="closing wrap"><div><h2>{t.closing}</h2><p>{t.closingText}</p></div><a class="text-link" href={localPath(locale, 'support')}>{t.contact}<span aria-hidden="true">↗</span></a></section>
