---
import ProductShot from './ProductShot.astro';
import type { App } from '../data/apps';
import { ui, localPath } from '../i18n';
import type { Locale } from '../i18n';
interface Props { app: App; locale: Locale; section: string; }
const { app, locale, section } = Astro.props;
const t = ui[locale];
const copy = app.translations[locale];
const route = `apps/${app.slug}`;
const sections = section === 'privacy' ? copy.privacy : copy.support;
---
<div class="wrap product-nav"><a href={localPath(locale)}>← {t.allApps}</a><nav aria-label={app.name}><a href={localPath(locale, route)} aria-current={!section ? 'page' : undefined}>{t.overview}</a><a href={localPath(locale, `${route}/support`)} aria-current={section === 'support' ? 'page' : undefined}>{t.support}</a><a href={localPath(locale, `${route}/privacy`)} aria-current={section === 'privacy' ? 'page' : undefined}>{t.privacy}</a></nav></div>
{!section ? <>
  <section class="product-hero wrap">
    <div class="featured-copy"><div class="app-identity"><img src={app.icon} width="64" height="64" alt="" /><div><p class="app-name">{app.name}</p><span>{t.requirements}</span></div></div><h1>{copy.tagline}</h1><p>{copy.description}</p><div class="actions">{app.appStoreUrl ? <a class="button" href={app.appStoreUrl}>{t.store} ↗</a> : <a class="button" href="#install">{t.installMac} ↓</a>}<a class="text-link" href={app.repo}>{t.code} ↗</a></div><p class="requirements">{t.signed}<br />{t.distribution}</p></div>
    <ProductShot app={app} locale={locale} />
  </section>
  <section class="features wrap">{copy.features.map((feature, i) => <div><span class="index">0{i + 1}</span><h2>{feature.title}</h2><p>{feature.text}</p></div>)}</section>
  <section id="install" class="install wrap"><div><p class="eyebrow">{t.quickStart}</p><h2>{t.installTitle}</h2><p>{t.requirements}. {copy.installNote}</p><a class="text-link" href={`${app.repo}/releases/latest`}>{t.latestRelease} ↗</a></div><div class="steps">{copy.steps.map((step, i) => <><h3><span>0{i + 1}</span>{step.title}</h3><p>{step.text}</p>{step.command && <div class="code-block"><code id={`command-${i}`}>{step.command}</code><button class="copy" data-copy={`command-${i}`} aria-label={`${t.copyLabel}: ${step.title}`} hidden>{t.copy}</button></div>}{step.scriptUrl && <p class="small"><a href={step.scriptUrl}>{t.reviewScript} ↗</a></p>}</>)}<p class="copy-status small" role="status" aria-live="polite" data-success={t.copied} data-error={t.copyFailed}></p></div></section>
  <section class="faq wrap"><h2>{t.faq}</h2><div>{copy.faq.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</div></section>
</> : <article class="prose wrap">
  <p class="eyebrow">{app.name} / {section === 'privacy' ? t.privacyEyebrow : t.supportEyebrow}</p><h1>{section === 'privacy' ? copy.privacyTitle : t.supportTitle}</h1><p class="lead">{section === 'privacy' ? copy.privacyIntro : copy.supportIntro}</p>
  {sections.map(s => <section><h2>{s.title}</h2>{s.paragraphs.map(text => <p>{text}</p>)}{s.items && <ol>{s.items.map(text => <li>{text}</li>)}</ol>}</section>)}
  {section === 'support' ? <><p class="small">{t.issueWarning}</p><a class="button" href={`${app.repo}/issues/new`}>{t.openIssue} ↗</a><p class="document-link"><a href={`${app.repo}#readme`}>{t.fullDocs} ↗</a></p></> : <><p class="document-link"><a href={localPath(locale, `${route}/support`)}>{t.support} →</a></p><p><a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">{t.hostingPrivacy} ↗</a></p><p class="small privacy-note">{t.privacyNote} <a href={`${app.repo}#readme`}>{t.fullDocs} ↗</a></p></>}
</article>}
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(button => {
    button.hidden = false;
    button.addEventListener('click', async () => {
      const text = document.getElementById(button.dataset.copy || '')?.textContent;
      const status = document.querySelector<HTMLElement>('.copy-status');
      if (!text || !status) return;
      try { await navigator.clipboard.writeText(text); status.textContent = status.dataset.success || ''; }
      catch { status.textContent = status.dataset.error || ''; }
    });
  });
</script>
