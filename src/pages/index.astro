---
import Base from '../layouts/Base.astro';
import ProductShot from '../components/ProductShot.astro';
import { apps } from '../data/apps';
const featured = apps[0];
---
<Base title="bobuk.io — небольшие приложения для больших дел" description="Независимые приложения bobuk.io с открытым исходным кодом. Сделаны для реальных задач, без лишнего шума.">
  <section class="intro wrap">
    <p class="eyebrow"><span class="small-line"></span> Независимые приложения с открытым кодом</p>
    <h1>Меньше шума.<br /><span class="soft">Больше своего дела.</span></h1>
    <div class="intro-bottom"><p>Небольшие инструменты, которые решают конкретную задачу.<br class="desktop-break" /> Сделаны с вниманием к вашему времени.</p><a class="text-link" href="#apps">Найти своё приложение <span aria-hidden="true">↓</span></a></div>
  </section>
  <section id="apps" class="catalog wrap" aria-labelledby="apps-title">
    <div class="section-heading"><h2 id="apps-title">Приложения</h2><span class="muted">{String(apps.length).padStart(2, '0')} / публичный каталог</span></div>
    {featured ? <article class="featured">
      <div class="featured-copy">
        <div class="app-identity"><img src={featured.icon} width="64" height="64" alt="" /><div><h3>{featured.name}</h3><span>{featured.platform} <span aria-hidden="true">/</span> {featured.category}</span></div></div>
        <h2>Агенты работают.<br />Вы — не отвлекаетесь.</h2>
        <p>{featured.description}</p>
        <div class="actions"><a class="button" href={`/apps/${featured.slug}/`}>Познакомиться <span aria-hidden="true">↗</span></a><a class="text-link" href={`/apps/${featured.slug}/#install`}>Установить <span aria-hidden="true">↓</span></a></div>
        <p class="requirements">{featured.requirements}</p>
        <div class="integrations"><span>В компании с</span><strong>Claude Code</strong><strong>Codex</strong><strong>pi</strong></div>
      </div>
      <ProductShot app={featured} />
    </article> : <p class="empty">Публичных приложений пока нет. Загляните позже.</p>}
    {apps.slice(1).map(app => <article class="app-row"><div><h3>{app.name}</h3><p>{app.description}</p></div><a class="button secondary" href={`/apps/${app.slug}/`}>Подробнее ↗</a></article>)}
  </section>
  <section class="principles wrap" aria-label="Подход">
    <div><span class="index">01 / По делу</span><h3>Одна задача. Хорошо.</h3><p>Не комбайн на все случаи жизни, а инструмент, которому находится место в обычном дне.</p></div>
    <div><span class="index">02 / Открыто</span><h3>Код — не секрет.</h3><p>В каталоге только публичные проекты bobuk-io. Можно посмотреть, как всё устроено, и предложить улучшение.</p></div>
    <div><span class="index">03 / На связи</span><h3>Есть куда написать.</h3><p>У каждого приложения свои инструкции, страница поддержки и информация о данных.</p></div>
  </section>
  <section class="closing wrap"><div><h2>Хорошие инструменты<br />не требуют лишнего внимания.</h2><p>А если что-то пошло не так — давайте разберёмся.</p></div><a class="text-link" href="/support/">Перейти в поддержку <span aria-hidden="true">↗</span></a></section>
</Base>
