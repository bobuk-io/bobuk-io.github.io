---
import Base from '../layouts/Base.astro';
import { locales, ui, localPath } from '../i18n';
---
<Base title="Page not found · bobuk.io" description="Return to the bobuk.io apps catalog." locale="en" route="404" noindex>
  <section class="prose wrap"><p class="eyebrow">404 / {ui.en.notFound}</p><h1>{ui.en.notFoundTitle}</h1>{locales.map(locale => <section lang={locale} class="not-found-language"><p>{ui[locale].notFoundText}</p><a class="text-link" href={localPath(locale)}>{ui[locale].back} →</a></section>)}</section>
</Base>
