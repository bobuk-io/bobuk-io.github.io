---
import Base from '../layouts/Base.astro';
import Home from '../components/Home.astro';
import Product from '../components/Product.astro';
import { apps } from '../data/apps';
import type { App } from '../data/apps';
import { locales, ui, localPath } from '../i18n';
import type { Locale } from '../i18n';

export function getStaticPaths() {
  return locales.flatMap(locale => {
    const pages = [
      { route: '', app: undefined, section: '' },
      { route: 'support', app: undefined, section: '' },
      ...apps.flatMap(app => ['', 'support', 'privacy'].map(section => ({ route: `apps/${app.slug}${section ? `/${section}` : ''}`, app, section }))),
    ];
    return pages.map(page => ({ params: { route: localPath(locale, page.route).replace(/^\/|\/$/g, '') || undefined }, props: { ...page, locale } }));
  });
}
interface Props { locale: Locale; route: string; app?: App; section: string; }
const { locale, route, app, section } = Astro.props;
const t = ui[locale];
const copy = app?.translations[locale];
const pageTitle = app && copy ? `${app.name} — ${section === 'support' ? t.support : section === 'privacy' ? t.privacy : copy.tagline}` : route === 'support' ? t.support : t.siteTitle;
const description = app && copy ? section === 'support' ? copy.supportIntro : section === 'privacy' ? copy.privacyIntro : copy.description : route === 'support' ? t.supportHomeIntro : t.siteDescription;
const schema = app && copy && !section ? { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: app.name, operatingSystem: app.platform, applicationCategory: 'UtilitiesApplication', description: copy.description, inLanguage: locale, url: new URL(localPath(locale, route), Astro.site).href, downloadUrl: `${app.repo}/releases/latest`, image: new URL(app.screenshot || app.icon, Astro.site).href } : undefined;
---
<Base title={`${pageTitle} · bobuk.io`} description={description} locale={locale} route={route} image={app?.screenshot || app?.icon}>
  {schema && <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
  {app ? <Product app={app} locale={locale} section={section} /> : route === 'support' ? <section class="prose wrap"><p class="eyebrow">{t.support}</p><h1>{t.supportHomeTitle}</h1><p class="lead">{t.supportHomeIntro}</p>{apps.map(item => <a class="support-row" href={localPath(locale, `apps/${item.slug}/support`)}><img src={item.icon} width="56" height="56" alt="" /><span><strong>{item.name}</strong><small>{item.platform} · {t.supportRow}</small></span><span aria-hidden="true">↗</span></a>)}<h2>{t.website}</h2><p>{t.websiteText}</p><p><a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">{t.hostingPrivacy} ↗</a></p></section> : <Home locale={locale} />}
</Base>
