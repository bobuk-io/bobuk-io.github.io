---
import '../styles/global.css';
import { locales, ui, languageNames, ogLocales, localPath } from '../i18n';
import type { Locale } from '../i18n';
interface Props { title: string; description: string; locale: Locale; route?: string; image?: string; noindex?: boolean; }
const { title, description, locale, route = '', image = '/images/splash-finish.png', noindex = false } = Astro.props;
const t = ui[locale];
const canonical = new URL(localPath(locale, route), Astro.site);
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!noindex && <>{locales.map(lang => <link rel="alternate" hreflang={lang} href={new URL(localPath(lang, route), Astro.site)} />)}<link rel="alternate" hreflang="x-default" href={new URL(localPath('en', route), Astro.site)} /></>}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f5f3ec" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocales[locale]} />
    {locales.filter(lang => lang !== locale).map(lang => <meta property="og:locale:alternate" content={ogLocales[lang]} />)}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="header wrap">
      <a class="brand" href={localPath(locale)} aria-label={`bobuk.io — ${t.home}`}><span class="brand-mark" aria-hidden="true">b.</span> bobuk<span class="brand-dot">.io</span></a>
      <nav aria-label={t.apps}>
        <a href={`${localPath(locale)}#apps`} aria-current={!route ? 'page' : undefined}>{t.apps}</a>
        <a href={localPath(locale, 'support')}>{t.support}</a>
        <a class="github-link" href="https://github.com/bobuk-io">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
      <nav class="languages" aria-label={t.language}>
        {locales.map(lang => <a href={localPath(lang, noindex ? '' : route)} lang={lang} hreflang={lang} aria-label={languageNames[lang]} aria-current={lang === locale ? 'true' : undefined}>{lang.toUpperCase()}</a>)}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer wrap">
      <a class="brand" href={localPath(locale)}>bobuk<span class="brand-dot">.io</span></a>
      <p>{t.footer}</p>
      <div><a href={localPath(locale, 'support')}>{t.support}</a><a href="https://github.com/bobuk-io">{t.code} ↗</a></div>
    </footer>
  </body>
</html>
